---
// Hidden page (not linked, noindex) showing every token and component in one
// place so the design can be reviewed without clicking through the site.
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import PostCard from '../components/PostCard.astro';
import ExecCard from '../components/ExecCard.astro';
import LogoGrid from '../components/LogoGrid.astro';
import EducationCards from '../components/EducationCards.astro';
import logos from '../data/logos.json';

// Token names only; the hex values are read from the live stylesheet in the
// browser so this page can never drift from global.css.
const palette = [
	['gold', 'Buttons on dark, headings on dark, highlights'],
	['gold-tint', 'Faint gold tint for light section backgrounds'],
	['gold-hover', 'Hover state on light surfaces'],
	['gold-pressed', 'Gold hover / pressed on dark'],
	['gold-deep', 'Gold text on white'],
	['black', 'Primary text on light sections'],
	['ink', 'Page background on dark sections'],
	['graphite', 'Cards and nav on dark backgrounds'],
	['ash', 'Muted, secondary text'],
	['light', 'Light section background'],
	['white', 'Light cards'],
	['warning', 'Warning'],
	['gain', 'Gain / success'],
	['loss', 'Loss / error'],
];
// [utility name, underlying CSS variable]
const roles = [
	['surface', '--bg'], ['fg', '--fg'], ['muted', '--muted'], ['card', '--card'], ['card-hover', '--card-hover'], ['edge', '--edge'],
	['heading', '--heading'], ['accent', '--accent'], ['accent-hover', '--accent-hover'], ['btn', '--btn-bg'], ['btn-fg', '--btn-fg'], ['btn-hover', '--btn-hover'],
];
const type = [
	['Display', 'text-5xl font-semibold tracking-tight text-heading', 'Page titles (PageHeader)'],
	['H2', 'text-3xl font-semibold tracking-tight text-heading', 'Section titles (SectionHeading)'],
	['H3', 'text-lg font-semibold', 'Card titles'],
	['Body', 'text-base', 'Default paragraph text'],
	['Lede', 'text-lg text-muted', 'Intro paragraph under a title'],
	['Small', 'text-sm text-muted', 'Supporting text'],
	['Eyebrow', 'eyebrow', 'Mono label above a heading'],
	['Meta', 'meta', 'Mono dates, authors, counts'],
	['Number', 'font-mono text-4xl font-medium text-accent', 'Stats'],
];
---

<Layout title="Style guide" noindex>
	<PageHeader eyebrow="Internal" title="Style guide" lede="Every color, text style, and component in the design system, generated from the same tokens the site uses." />

	<div class="site-container space-y-20 py-16">
		<section>
			<SectionHeading title="Palette" lede="Brand colors defined in src/styles/global.css. Use them via Tailwind utilities such as bg-gold or text-ash." />
			<ul class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
				{palette.map(([name, use]) => (
					<li class="overflow-hidden rounded-lg border border-edge bg-card">
						<div class="h-16" style={`background: var(--color-${name})`}></div>
						<div class="p-3">
							<p class="font-mono text-sm">{name}</p>
							<p class="meta" data-token={`--color-${name}`}>…</p>
							<p class="mt-1 text-xs text-muted">{use}</p>
						</div>
					</li>
				))}
			</ul>
		</section>

		<section>
			<SectionHeading title="Semantic roles" lede="What components actually use. These map to the palette and flip automatically inside data-tone=&quot;light&quot;." />
			<div class="mt-8 grid gap-4 md:grid-cols-2">
				{['dark', 'light'].map((tone) => (
					<div data-tone={tone} class="rounded-lg border border-edge p-5">
						<p class="eyebrow">data-tone="{tone}"</p>
						<ul class="mt-3 grid grid-cols-3 gap-2">
							{roles.map(([r, v]) => (
								<li class="flex items-center gap-2 text-xs">
									<span class="h-5 w-5 shrink-0 rounded border border-edge" style={`background: var(${v})`}></span>
									<span class="font-mono">{r}</span>
								</li>
							))}
						</ul>
						<p class="mt-4 text-sm">Body text on this surface, with <a href="#" class="text-accent underline">a link</a> and <span class="text-muted">muted text</span>.</p>
						<div class="mt-3 flex gap-2"><Button size="sm">Primary</Button><Button size="sm" variant="secondary">Secondary</Button></div>
					</div>
				))}
			</div>
		</section>

		<section>
			<SectionHeading title="Typography" lede="IBM Plex Sans for headings and body, IBM Plex Mono for numbers, dates, and labels." />
			<ul class="mt-8 divide-y divide-edge">
				{type.map(([name, cls, use]) => (
					<li class="grid gap-2 py-5 sm:grid-cols-[8rem_1fr_14rem] sm:items-baseline">
						<p class="meta">{name}</p>
						<p class={cls}>The quick brown fox jumps over 1,234.56</p>
						<p class="text-xs text-muted"><span class="font-mono">{cls}</span><br />{use}</p>
					</li>
				))}
			</ul>
		</section>

		<section>
			<SectionHeading title="Status colors" lede="For the trading simulation and anything that reports a result." />
			<div class="mt-8 flex flex-wrap gap-3 font-mono text-sm">
				<span class="rounded-md border border-gain/40 bg-gain/10 px-3 py-1.5 text-gain">+2.41% gain</span>
				<span class="rounded-md border border-loss/40 bg-loss/10 px-3 py-1.5 text-loss">−1.07% loss</span>
				<span class="rounded-md border border-warning/40 bg-warning/10 px-3 py-1.5 text-warning">warning</span>
			</div>
		</section>

		<section>
			<SectionHeading title="Buttons" />
			<div class="mt-8 flex flex-wrap items-center gap-3">
				<Button size="sm">Small</Button><Button>Medium</Button><Button size="lg">Large</Button>
				<Button variant="secondary">Secondary</Button><Button variant="ghost">Ghost →</Button>
			</div>
		</section>

		<section>
			<SectionHeading title="Cards" lede="Static card and link card (hover to see the state)." />
			<div class="mt-8 grid gap-5 md:grid-cols-2">
				<Card><h3 class="text-lg font-semibold">Static card</h3><p class="mt-2 text-sm text-muted">Plain container for grouped content.</p></Card>
				<Card href="#"><h3 class="text-lg font-semibold">Link card</h3><p class="mt-2 text-sm text-muted">Whole card is clickable.</p><p class="mt-5 text-sm font-medium text-accent">Learn more →</p></Card>
			</div>
		</section>

		<section>
			<SectionHeading title="Section heading" lede="With and without an eyebrow." />
			<div class="mt-8 space-y-10">
				<SectionHeading eyebrow="Eyebrow" title="Heading with eyebrow" lede="Optional lede text beneath the title." />
				<SectionHeading title="Heading without eyebrow" />
			</div>
		</section>

		<section>
			<SectionHeading title="Post card" lede="Used for the news list. One per row." />
			<div class="mt-8 max-w-4xl">
				<PostCard href="#" title="A gentle introduction to market making" summary="What a market maker does, and why the bid-ask spread exists." tag="Education" label="fig. 01" meta="Nathan Li · October 10, 2026" />
			</div>
		</section>

		<section>
			<SectionHeading title="Exec card" />
			<div class="mt-8 grid max-w-md grid-cols-2 gap-5">
				<ExecCard name="Firstname Lastname" role="President" />
				<ExecCard name="Firstname Lastname" role="Vice President" />
			</div>
		</section>

		<section>
			<SectionHeading title="Education cards" lede="Auto-rotates; click a tab to pin it." />
			<div class="mt-8"><EducationCards /></div>
		</section>

		<section>
			<SectionHeading title="Logo grid" />
			<div class="mt-8"><LogoGrid logos={logos.slice(0, 10)} /></div>
		</section>
	</div>
</Layout>

<script>
	// Fill in the live hex value of each palette token from the stylesheet.
	// Runs on first load and after each client-side navigation to this page.
	document.addEventListener('astro:page-load', () => {
		const styles = getComputedStyle(document.documentElement);
		document.querySelectorAll<HTMLElement>('[data-token]').forEach((el) => {
			el.textContent = styles.getPropertyValue(el.dataset.token!).trim() || '(unset)';
		});
	});
</script>
