---
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EducationCards from '../components/EducationCards.astro';
import ExecCard from '../components/ExecCard.astro';
import executives from '../data/executives.json';

// Headshots live in src/assets so Astro can resize them. Match each exec's
// "Photo" filename (from the JSON) to the imported image.
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/exec_pictures/*.{jpg,jpeg}', { eager: true });
const photoFor = (path: string) => photos[`../assets/exec_pictures/${path.split('/').pop()}`]?.default;

// Row 1: president + VP. Row 2 in this fixed order.
const byRole = (role: string) => executives.find((e) => e.Role === role);
const rowOne = ['President', 'Vice President'].map(byRole).filter(Boolean);
const rowTwo = ['Director of Projects', 'Director of People', 'Director of Operations', 'Director of Marketing', 'Director of Relations']
	.map(byRole)
	.filter(Boolean);
---

<Layout title="About">
	<PageHeader
		title="A club for students who want to understand markets, not just watch them."
		lede="Boiler Quant was founded in 2019 by a handful of Purdue students who couldn't find a place on campus to talk about quantitative trading. Today we're one of the largest finance organizations at the university, open to every major and every year."
	/>

	<section id="education" class="site-container py-16 sm:py-20">
		<SectionHeading
			title="Education"
			lede="Member-run prep sessions in four tracks. Each runs weekly through the semester and is open to everyone in the club."
		/>
		<div class="mt-8">
			<EducationCards />
		</div>
	</section>

	<section id="exec" class="border-t border-edge">
		<div class="site-container py-16 sm:py-20">
			<SectionHeading title="Executive Board" lede="The students running the club this year." />
			<div class="mx-auto mt-10 grid max-w-md grid-cols-2 gap-5 sm:gap-6">
				{rowOne.map((e) => e && <ExecCard name={e['Full Name']} role={e.Role} photo={photoFor(e.Photo)} linkedin={e.LinkedIn} />)}
			</div>
			<div class="mt-8 grid grid-cols-2 gap-5 sm:grid-cols-3 sm:gap-6 lg:grid-cols-5">
				{rowTwo.map((e) => e && <ExecCard name={e['Full Name']} role={e.Role} photo={photoFor(e.Photo)} linkedin={e.LinkedIn} />)}
			</div>
		</div>
	</section>
</Layout>
