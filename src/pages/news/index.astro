---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { formatDate, formatShortDate, byDateDesc } from '../../lib/format';

const items = (await getCollection('news', ({ data }) => !data.draft)).sort(byDateDesc);
---

<Layout title="News & Events">
	<PageHeader title="News & Events" lede="Upcoming events and announcements from the club." />
	<section class="site-container max-w-4xl space-y-4 py-12">
		{items.map((item) => (
			<PostCard
				href={`/news/${item.id}`}
				title={item.data.title}
				summary={item.data.description}
				tag={item.data.type}
				label={formatShortDate(item.data.date)}
				meta={[formatDate(item.data.date), item.data.location].filter(Boolean).join(' · ')}
			/>
		))}
	</section>
</Layout>
