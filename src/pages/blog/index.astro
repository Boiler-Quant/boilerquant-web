---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { formatDate, byDateDesc } from '../../lib/format';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(byDateDesc);
---

<Layout title="Blog">
	<PageHeader title="Notes from the club" lede="Writing from members on quant finance, project work, and life in the club." />
	<section class="site-container max-w-4xl space-y-4 py-12">
		{posts.map((post, i) => (
			<PostCard
				href={`/blog/${post.id}`}
				title={post.data.title}
				summary={post.data.description}
				tag={post.data.tag}
				label={`fig. ${String(posts.length - i).padStart(2, '0')}`}
				meta={[post.data.author, formatDate(post.data.date)].filter(Boolean).join(' · ')}
			/>
		))}
	</section>
</Layout>
