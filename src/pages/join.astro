---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Button from '../components/Button.astro';
---

<Layout title="Join us">
	<PageHeader title="Join Boiler Quant" lede="Recruitment is currently closed for the Fall 2026 semester." />
	<section class="site-container max-w-2xl py-12">
		<p class="text-muted">
			Follow us on Instagram and Linkedin to stay up to date with events and recruitment announcements!
		</p>
		<div class="mt-8 flex flex-wrap gap-3">
			<Button href="https://www.instagram.com/boilerquant/" target="_blank" rel="noopener noreferrer">Instagram</Button>
			<Button href="https://www.linkedin.com/company/boilerquant/" target="_blank" rel="noopener noreferrer">LinkedIn</Button>
			<Button href="mailto:boilerquant@gmail.com" variant="secondary">Email us</Button>
		</div>
	</section>
</Layout>
