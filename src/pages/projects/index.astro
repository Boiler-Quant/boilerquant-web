---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { formatDate, byDateDesc } from '../../lib/format';

const all = (await getCollection('projects', ({ data }) => !data.draft)).sort(byDateDesc);
const current = all.filter((p) => p.data.status === 'current');
const completed = all.filter((p) => p.data.status === 'completed');
const season = (d: Date) => `${d.getUTCMonth() < 6 ? 'Spring' : 'Fall'} ${d.getUTCFullYear()}`;

// Each group is a collapsible <details> section, open by default.
const groups = [
	{ title: 'Current projects', items: current, empty: 'No projects running right now. Check back at the start of the semester.' },
	{ title: 'Completed projects', items: completed, empty: 'Nothing here yet.' },
];
---

<Layout title="Projects">
	<PageHeader
		title="Projects"
		divider={false}
	/>

	<div class="site-container space-y-12 pb-20">
		{groups.map((g) => (
			<details open class="group">
				<summary class="flex cursor-pointer list-none items-center gap-3 select-none [&::-webkit-details-marker]:hidden">
					<h2 class="text-3xl font-semibold tracking-tight text-heading">{g.title}</h2>
					<span class="meta">({g.items.length})</span>
					<svg
						class="ml-1 h-5 w-5 text-muted transition-transform group-open:rotate-180"
						viewBox="0 0 20 20"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M5 8l5 5 5-5" />
					</svg>
				</summary>
				<div class="mt-6">
					{g.items.length === 0 && <p class="text-muted">{g.empty}</p>}
					{g.items.length > 0 && (
						<div class="grid gap-5 sm:grid-cols-2">
							{g.items.map((p) => (
								<ProjectCard
									href={`/projects/${p.id}`}
									title={p.data.title}
									summary={p.data.description}
									tag={p.data.tag}
									label={season(p.data.date)}
									meta={[p.data.lead && `Led by ${p.data.lead}`, p.data.status === 'current' ? `Started ${formatDate(p.data.date)}` : season(p.data.date)]
										.filter(Boolean)
										.join(' · ')}
								/>
							))}
						</div>
					)}
				</div>
			</details>
		))}
	</div>
</Layout>
