---
import { directions } from '../../components/demo/directions';
---
<html lang="en"><head><meta charset="utf-8" /><meta name="robots" content="noindex" /><title>Design direction demos</title></head>
<body style="font-family: system-ui; padding: 2rem; max-width: 40rem">
	<h1>Design direction demos</h1>
	<p>Temporary pages. Each direction has a home, an about page, and a blog list.</p>
	{Object.entries(directions).map(([k, d]) => (
		<p><strong>{k.toUpperCase()} · {d.name}</strong> — {d.tagline}<br />
			<a href={`/demo/${k}/`}>Home</a> · <a href={`/demo/${k}/about`}>About</a> · <a href={`/demo/${k}/blog`}>Blog</a></p>
	))}
</body></html>
