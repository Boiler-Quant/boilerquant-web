---
// Title block at the top of every inner page.
interface Props { eyebrow?: string; title: string; lede?: string; divider?: boolean }
const { eyebrow, title, lede, divider = true } = Astro.props;
---

<header class:list={[divider && 'border-b border-edge']}>
	<div class="site-container pt-16 pb-12 sm:pt-20 sm:pb-14">
		{eyebrow && <p class="eyebrow">{eyebrow}</p>}
		<h1 class:list={['max-w-3xl text-4xl font-semibold tracking-tight text-heading sm:text-5xl', eyebrow && 'mt-3']}>{title}</h1>
		{lede && <p class="mt-5 max-w-2xl text-lg text-muted">{lede}</p>}
		<slot />
	</div>
</header>
