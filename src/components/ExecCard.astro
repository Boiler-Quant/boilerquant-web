---
// One exec board member: square photo, name, role, LinkedIn.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { name: string; role: string; photo?: ImageMetadata; linkedin?: string }
const { name, role, photo, linkedin } = Astro.props;
---

<div class="flex flex-col">
	<div class="aspect-square overflow-hidden rounded-lg border border-edge bg-card">
		{photo ? (
			<Image src={photo} alt={name} width={480} height={480} fit="cover" position="top" class="h-full w-full object-cover" />
		) : (
			<div class="flex h-full items-center justify-center font-mono text-xs text-muted">no photo</div>
		)}
	</div>
	<h3 class="mt-3 leading-tight font-semibold">{name}</h3>
	<p class="mt-0.5 text-sm text-muted">{role}</p>
	<a href={linkedin ?? '#'} target="_blank" rel="noopener noreferrer" class="mt-1.5 text-sm text-accent hover:text-accent-hover hover:underline">LinkedIn →</a>
</div>
