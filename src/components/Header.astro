---
// Site-wide navigation. Inline links on wide screens; hamburger menu on phones.
import Button from './Button.astro';

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/projects', label: 'Projects' },
	{ href: '/placements', label: 'Placements' },
	{ href: '/news', label: 'News' },
];
const currentPath = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
---

<header class="sticky top-0 z-20 border-b border-edge bg-card">
	<nav class="site-container flex items-center justify-between py-3.5" aria-label="Main">
		<a href="/" class="flex items-center gap-3">
			<img src="/club_logos/bq_logo_black.png" alt="" width="32" height="32" class="h-8 w-8 rounded-sm" />
			<span class="text-base font-semibold tracking-tight">Boiler Quant</span>
		</a>

		<ul class="hidden items-center gap-1 md:flex">
			{links.map((l) => (
				<li>
					<a
						href={l.href}
						aria-current={isActive(l.href) ? 'page' : undefined}
						class:list={[
							'block rounded-md px-3.5 py-2 text-sm transition-colors hover:bg-card-hover hover:text-accent',
							isActive(l.href) ? 'font-medium text-accent' : 'text-fg',
						]}
					>
						{l.label}
					</a>
				</li>
			))}
			<li class="ml-4"><Button href="/join" size="sm">Join us</Button></li>
		</ul>

		<button
			id="menu-toggle"
			type="button"
			class="rounded-md border border-edge px-3 py-2 text-sm hover:bg-card-hover md:hidden"
			aria-controls="mobile-menu"
			aria-expanded="false"
		>
			<span class="sr-only">Toggle menu</span>
			<span aria-hidden="true" data-icon-open>☰</span>
			<span aria-hidden="true" data-icon-close class="hidden">✕</span>
		</button>
	</nav>

	<div id="mobile-menu" class="hidden border-t border-edge md:hidden">
		<ul class="site-container py-2">
			{links.map((l) => (
				<li>
					<a
						href={l.href}
						aria-current={isActive(l.href) ? 'page' : undefined}
						class:list={['block py-3 text-base', isActive(l.href) ? 'font-medium text-accent' : 'text-fg']}
					>
						{l.label}
					</a>
				</li>
			))}
			<li class="py-3"><Button href="/join" class="w-full">Join us</Button></li>
		</ul>
	</div>

	{/* Scroll progress line: a thin gold light along the header's bottom edge that grows
	   from left to right as you scroll down the page (empty at the top, full at the
	   bottom). It stays empty on pages too short to scroll. */}
	<div
		id="scroll-progress"
		class="pointer-events-none absolute inset-x-0 -bottom-px h-0.5 origin-left bg-accent"
		style="transform: scaleX(var(--scroll-progress, 0))"
		aria-hidden="true"
	></div>
</header>

<style>
	#scroll-progress {
		box-shadow: 0 0 8px var(--accent); /* soft glow, so it reads as a light */
	}
	/* The browser ties the line's width directly to the scroll position. Browsers
	   without this feature use the --scroll-progress value set by the script below. */
	@supports (animation-timeline: scroll()) {
		#scroll-progress {
			animation: scroll-progress linear both;
			animation-timeline: scroll(root); /* 0% at the top of the page, 100% at the bottom */
		}
	}
	@keyframes scroll-progress {
		from { transform: scaleX(0); }
		to { transform: scaleX(1); }
	}
</style>

<script>
	// With client-side routing (ClientRouter) this module runs once per visit, but the
	// header markup is re-rendered on every page swap. So element wiring happens inside
	// astro:page-load (fires on first load and after each navigation); window/document
	// listeners are registered once and call whichever setOpen is current.
	let setOpen = (_open: boolean) => {};
	document.addEventListener('astro:page-load', () => {
		const button = document.getElementById('menu-toggle');
		const menu = document.getElementById('mobile-menu');
		if (!button || !menu) return;
		setOpen = (open: boolean) => {
			menu.classList.toggle('hidden', !open);
			button.setAttribute('aria-expanded', String(open));
			button.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
			button.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
		};
		button.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
		// Close when a link is tapped.
		menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
	});
	// Close when the window grows past the phone breakpoint, or on Escape.
	window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
	document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });

	// Scroll progress line, fallback for browsers without CSS scroll-driven animations:
	// publish how far down the page we are (0 to 1) as --scroll-progress.
	if (!CSS.supports('animation-timeline', 'scroll()')) {
		const root = document.documentElement;
		const update = () => {
			const max = root.scrollHeight - window.innerHeight;
			root.style.setProperty('--scroll-progress', (max > 0 ? Math.min(1, window.scrollY / max) : 0).toFixed(4));
		};
		window.addEventListener('scroll', update, { passive: true });
		window.addEventListener('resize', update);
		document.addEventListener('astro:page-load', update);
	}
</script>
