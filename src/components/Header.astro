---
// Site-wide navigation. Inline links on wide screens; hamburger menu on phones.
import Button from './Button.astro';

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/about', label: 'About' },
	{ href: '/projects', label: 'Projects' },
	{ href: '/placements', label: 'Placements' },
	{ href: '/news', label: 'News' },
	{ href: '/blog', label: 'Blog' },
];
const currentPath = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
---

<header class="sticky top-0 z-20 border-b border-edge bg-card">
	<nav class="site-container flex items-center justify-between py-3.5" aria-label="Main">
		<a href="/" class="flex items-center gap-3">
			<img src="/club_logos/bq_logo_black.png" alt="" width="32" height="32" class="h-8 w-8 rounded-sm" />
			<span class="text-base font-semibold tracking-tight">Boiler Quant</span>
		</a>

		<ul class="hidden items-center gap-7 md:flex">
			{links.map((l) => (
				<li>
					<a
						href={l.href}
						aria-current={isActive(l.href) ? 'page' : undefined}
						class:list={['text-sm transition-colors hover:text-accent', isActive(l.href) ? 'font-medium text-accent' : 'text-fg']}
					>
						{l.label}
					</a>
				</li>
			))}
			<li><Button href="/join" size="sm">Join us</Button></li>
		</ul>

		<button
			id="menu-toggle"
			type="button"
			class="rounded-md border border-edge px-3 py-2 text-sm hover:bg-card-hover md:hidden"
			aria-controls="mobile-menu"
			aria-expanded="false"
		>
			<span class="sr-only">Toggle menu</span>
			<span aria-hidden="true" data-icon-open>☰</span>
			<span aria-hidden="true" data-icon-close class="hidden">✕</span>
		</button>
	</nav>

	<div id="mobile-menu" class="hidden border-t border-edge md:hidden">
		<ul class="site-container py-2">
			{links.map((l) => (
				<li>
					<a
						href={l.href}
						aria-current={isActive(l.href) ? 'page' : undefined}
						class:list={['block py-3 text-base', isActive(l.href) ? 'font-medium text-accent' : 'text-fg']}
					>
						{l.label}
					</a>
				</li>
			))}
			<li class="py-3"><Button href="/join" class="w-full">Join us</Button></li>
		</ul>
	</div>
</header>

<script>
	const button = document.getElementById('menu-toggle')!;
	const menu = document.getElementById('mobile-menu')!;
	const setOpen = (open: boolean) => {
		menu.classList.toggle('hidden', !open);
		button.setAttribute('aria-expanded', String(open));
		button.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
		button.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
	};
	button.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
	// Close when a link is tapped or the window grows past the phone breakpoint.
	menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
	window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
	document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
</script>
