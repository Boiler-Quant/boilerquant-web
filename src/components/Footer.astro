---
// Site-wide footer: short blurb, link columns, copyright.
const year = new Date().getFullYear();
const columns = [
	{ title: 'Club', items: [['About', '/about'], ['Projects', '/projects'], ['Placements', '/placements'], ['Join us', '/join']] },
	{ title: 'Content', items: [['News & events', '/news'], ['Blog', '/blog']] },
	{
		title: 'Contact',
		items: [
			['boilerquant@gmail.com', 'mailto:boilerquant@gmail.com'],
			['Instagram', 'https://www.instagram.com/boilerquant/'],
			['LinkedIn', 'https://www.linkedin.com/company/boilerquant/'],
		],
	},
];
---

<footer class="mt-24 border-t border-edge">
	<div class="site-container grid gap-10 py-14 md:grid-cols-[1.5fr_1fr_1fr_1fr]">
		<div>
			<p class="text-lg font-semibold">Boiler Quant</p>
			<p class="mt-2 max-w-xs text-sm text-muted">Purdue University's quantitative finance club.</p>
		</div>
		{columns.map((c) => (
			<div>
				<p class="eyebrow">{c.title}</p>
				<ul class="mt-3 space-y-2 text-sm">
					{c.items.map(([label, href]) => (
						<li>
							<a href={href} class="hover:text-accent" {...(href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{label}</a>
						</li>
					))}
				</ul>
			</div>
		))}
	</div>
	<div class="border-t border-edge">
		<p class="site-container meta py-5">© {year} Boiler Quant</p>
	</div>
</footer>
