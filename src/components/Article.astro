---
// Shell for a single blog post / news item / project page.
// The optional "header" slot renders extra lines at the bottom of the title block.
interface Props { backHref: string; backLabel: string; eyebrow?: string; title: string; meta?: string }
const { backHref, backLabel, eyebrow, title, meta } = Astro.props;
---

<article class="site-container max-w-3xl pt-12 sm:pt-16">
	<a href={backHref} class="meta hover:text-accent">&larr; {backLabel}</a>
	<header class="mt-6 border-b border-edge pb-8">
		{eyebrow && <p class="eyebrow">{eyebrow}</p>}
		<h1 class:list={['text-3xl font-semibold tracking-tight text-heading sm:text-4xl', eyebrow && 'mt-3']}>{title}</h1>
		{meta && <p class="meta mt-4">{meta}</p>}
		<slot name="header" />
	</header>
	<div class="prose prose-lg mt-8 max-w-none">
		<slot />
	</div>
</article>
