---
// Home page opening: a full-screen visual with the statement under it. Wide screens
// get the Monte Carlo fan (src/scripts/visuals/montecarlo.ts); tall (portrait) screens
// such as phones get the order book ladder (src/scripts/visuals/orderbook.ts), which
// suits a narrow canvas. The choice follows the orientation media query and swaps live
// if the device rotates. On scroll the text rises, the visual fades out and
// the rest of the paragraph fades in; the next section follows as soon as the
// paragraph is complete (the section is exactly one screen plus the transition).
//
// The hidden paragraph still takes up layout space, so the script measures that
// height (--extra) and shifts the block down by it at the top of the page; as you
// scroll the shift blends into --rise, which places the full block in view.
//
// Motion is a CSS scroll-driven animation (animation-timeline: scroll()), so the
// browser moves the text in lockstep with the scroll position. Browsers without
// support fall back to the JS scroll listener setting --p.
const statement = "We are Boiler Quant, Purdue's home for quantitative finance.";
const paragraph =
	"Through projects and industry relations, our members are prepped for careers at the world's top HFT firms and hedge funds.";
---

<section id="hero" class="relative h-[220vh]">
	<div id="hero-stage" class="sticky overflow-hidden" style="top: var(--header-h, 61px); height: calc(100vh - var(--header-h, 61px))">
		<canvas id="hero-viz" class="absolute inset-0 h-full w-full" style="opacity: calc(1 - var(--p, 0) * 1.4)" aria-hidden="true"></canvas>
		<div class="absolute inset-0 bg-linear-to-t from-surface via-transparent to-transparent" aria-hidden="true"></div>

		<div
			id="hero-text"
			class="site-container relative flex h-full flex-col justify-end pb-24 will-change-transform"
			style="transform: translateY(calc((1 - var(--p, 0)) * var(--extra, 0px) + var(--p, 0) * var(--rise, 0px)))"
		>
			<p class="max-w-4xl text-2xl leading-[1.2] font-medium tracking-tight sm:text-4xl lg:text-[2.75rem]">
				<span id="hero-statement">{statement}</span>
				<span id="hero-para" style="opacity: var(--p, 0)"> {paragraph}</span>
			</p>
		</div>
	</div>
</section>

<style>
	/* Scroll-driven version. The animations run from --anim-start to --anim-end (page
	   scroll offsets in px, set by the script) and override the --p inline styles above. */
	@supports (animation-timeline: scroll()) {
		#hero-text,
		#hero-viz,
		#hero-para {
			animation-timeline: scroll(root);
			animation-range: var(--anim-start, 0px) var(--anim-end, 100vh);
			animation-timing-function: linear;
			animation-fill-mode: both;
		}
		#hero-text { animation-name: hero-rise; }
		#hero-viz { animation-name: hero-fade-out; }
		#hero-para { animation-name: hero-fade-in; }
	}
	@keyframes hero-rise {
		from { transform: translateY(var(--extra, 0px)); }
		to { transform: translateY(var(--rise, 0px)); }
	}
	@keyframes hero-fade-out {
		from { opacity: 1; }
		71.4% { opacity: 0; } /* same curve as 1 - p * 1.4 */
		to { opacity: 0; }
	}
	@keyframes hero-fade-in {
		from { opacity: 0; }
		to { opacity: 1; }
	}
</style>

<script>
	import { montecarlo } from '../scripts/visuals/montecarlo';
	import { orderbook } from '../scripts/visuals/orderbook';

	const ANIM = 1.2; // screen-heights of scroll for the text/visual transition (section height = 100vh + this)
	const scrollDriven = CSS.supports('animation-timeline', 'scroll()');

	// Runs on first load and after each client-side navigation; the returned cleanup
	// stops the animation and removes listeners when the user leaves the page.
	const init = (hero: HTMLElement, canvas: HTMLCanvasElement) => {
		const ac = new AbortController();
		const { signal } = ac;
		const stage = document.getElementById('hero-stage')!;
		const para = document.querySelector<HTMLElement>('#hero-text p')!;
		const statement = document.getElementById('hero-statement')!;
		const header = document.querySelector<HTMLElement>('header');

		// Geometry, measured on load/resize only (never inside the scroll handler):
		// header height, hidden-paragraph height, how far the block rises, and the
		// scroll offsets over which the transition plays.
		let start = 0;
		let range = 1;
		const measure = () => {
			const headerH = header?.offsetHeight ?? 0;
			document.documentElement.style.setProperty('--header-h', `${headerH}px`);
			const extra = para.getBoundingClientRect().bottom - statement.getBoundingClientRect().bottom;
			const stageH = stage.clientHeight;
			const naturalTop = para.offsetTop; // where flex-end puts the block
			const targetTop = Math.max(24, (stageH - para.offsetHeight) / 2); // centred, or just below the header
			hero.style.setProperty('--extra', `${extra}px`);
			hero.style.setProperty('--rise', `${targetTop - naturalTop}px`);

			start = hero.offsetTop;
			range = Math.min(window.innerHeight * ANIM, hero.offsetHeight - stageH);
			hero.style.setProperty('--anim-start', `${start}px`);
			hero.style.setProperty('--anim-end', `${start + range}px`);
		};

		// Fallback for browsers without scroll-driven animations: 0 at the top, 1 after
		// `range` pixels of scrolling.
		const update = () => {
			const p = Math.min(1, Math.max(0, (window.scrollY - start) / range));
			hero.style.setProperty('--p', p.toFixed(3));
		};
		if (!scrollDriven) window.addEventListener('scroll', update, { passive: true, signal });
		window.addEventListener('resize', () => { measure(); if (!scrollDriven) update(); }, { signal });
		measure();
		if (!scrollDriven) update();
		document.fonts?.ready.then(measure); // re-measure once the web font has loaded

		// Colors and font come from the design tokens; nothing is hardcoded in the visual.
		const styles = getComputedStyle(document.documentElement);
		const v = (n: string) => styles.getPropertyValue(n).trim();
		const palette = { gold: v('--color-gold'), goldTint: v('--color-gold-tint'), ash: v('--color-ash'), gain: v('--color-gain'), loss: v('--color-loss'), mono: v('--font-mono') };
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		// Portrait (taller than wide) gets the order book ladder, landscape the fan.
		// Each visual returns its own cleanup; swap them if the orientation changes.
		const portrait = window.matchMedia('(orientation: portrait)');
		const mount = (isPortrait: boolean) => (isPortrait ? orderbook : montecarlo)(canvas, { palette, reduce });
		let stopVisual = mount(portrait.matches);
		portrait.addEventListener('change', (e) => { stopVisual(); stopVisual = mount(e.matches); }, { signal });

		return () => { ac.abort(); stopVisual(); };
	};

	let cleanup: (() => void) | undefined;
	document.addEventListener('astro:page-load', () => {
		cleanup?.();
		cleanup = undefined;
		const hero = document.getElementById('hero');
		const canvas = document.getElementById('hero-viz') as HTMLCanvasElement | null;
		if (hero && canvas) cleanup = init(hero, canvas);
	});
</script>
