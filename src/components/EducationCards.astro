---
// Rotating cards for the four prep-session tracks. Auto-advances every few
// seconds; clicking a tab selects it and pauses the rotation.
import education from '../data/education.json';
---

<div id="edu" class="rounded-lg border border-edge bg-card">
	<div role="tablist" aria-label="Prep session tracks" class="flex overflow-x-auto border-b border-edge">
		{education.map((t, i) => (
			<button
				role="tab"
				id={`edu-tab-${t.key}`}
				aria-controls={`edu-panel-${t.key}`}
				aria-selected={i === 0 ? 'true' : 'false'}
				data-index={i}
				class="relative shrink-0 px-5 py-3.5 text-sm font-medium text-muted transition-colors hover:text-fg aria-selected:text-accent"
			>
				{t.title}
				<span class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-accent transition-transform aria-selected:scale-x-100" aria-hidden="true"></span>
			</button>
		))}
	</div>
	{education.map((t, i) => (
		<div role="tabpanel" id={`edu-panel-${t.key}`} aria-labelledby={`edu-tab-${t.key}`} class:list={['p-6 sm:p-8', i !== 0 && 'hidden']}>
			<p class="eyebrow">Prep sessions</p>
			<h3 class="mt-2 text-2xl font-semibold text-heading">{t.title}</h3>
			<p class="mt-3 max-w-2xl text-muted">{t.description}</p>
			<p class="meta mt-5">Led by {t.lead}</p>
		</div>
	))}
</div>

<script>
	const root = document.getElementById('edu')!;
	const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
	const panels = [...root.querySelectorAll<HTMLElement>('[role=tabpanel]')];
	let current = 0;
	let timer: number | undefined;

	const show = (i: number) => {
		current = i;
		tabs.forEach((t, k) => t.setAttribute('aria-selected', String(k === i)));
		panels.forEach((p, k) => p.classList.toggle('hidden', k !== i));
		// The underline uses a CSS transition on aria-selected; re-sync the indicator.
		tabs.forEach((t, k) => t.querySelector('span')?.classList.toggle('scale-x-100', k === i));
		tabs.forEach((t, k) => t.querySelector('span')?.classList.toggle('scale-x-0', k !== i));
	};
	const start = () => {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		timer = window.setInterval(() => show((current + 1) % tabs.length), 6000);
	};
	const stop = () => { if (timer) clearInterval(timer); timer = undefined; };

	tabs.forEach((t, i) => t.addEventListener('click', () => { stop(); show(i); }));
	root.addEventListener('mouseenter', stop);
	root.addEventListener('mouseleave', () => { if (!timer) start(); });
	show(0);
	start();
</script>
