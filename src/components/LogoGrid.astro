---
// Grid of company logos, each linking to the company site. Tiles use the light
// tone because most logos are designed for white backgrounds.
interface Logo { name: string; image: string; website: string }
interface Props { logos: Logo[]; class?: string }
const { logos, class: className } = Astro.props;
---

<ul class:list={['grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4', className]}>
	{logos.map((l) => (
		<li>
			<a
				href={l.website}
				target="_blank"
				rel="noopener noreferrer"
				title={l.name}
				data-tone="light"
				class="flex h-28 items-center justify-center rounded-md border border-edge bg-card p-6 transition-colors hover:bg-card-hover"
			>
				<img src={l.image} alt={l.name} loading="lazy" class="max-h-14 max-w-full object-contain" />
			</a>
		</li>
	))}
</ul>
