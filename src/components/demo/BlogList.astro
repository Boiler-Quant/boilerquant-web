---
// Blog index: wide horizontal cards (thumbnail left, text right) stacked in
// columns — one column on phones, two on desktop.
import type { Tone } from './directions';
interface Props { header: Tone; list: Tone }
const { header, list } = Astro.props;
const posts = [
	['A gentle introduction to market making', 'What a market maker does, and why the bid-ask spread exists.', 'Nathan Li', 'Oct 10, 2026', 'Education', '01'],
	['Backtesting pitfalls we ran into this semester', 'Lookahead bias, survivorship bias, and the time we accidentally traded on tomorrow\'s close.', 'Parth Hathalia', 'Oct 3, 2026', 'Projects', '02'],
	['Recap: Fall 2026 poker tournament', 'Sixty players, four hours, and a surprisingly tight final table.', 'Mihika Shrivastava', 'Sep 26, 2026', 'Club life', '03'],
	['How we structure a research project', 'From hypothesis to a two-page writeup: the template every team uses.', 'Sandilya Kambhampati', 'Sep 18, 2026', 'Projects', '04'],
	['Interview prep: the probability questions that keep coming up', 'Expected value, conditional probability, and a few classics worth memorizing.', 'Caleb Suhy', 'Sep 9, 2026', 'Education', '05'],
	['Welcome to the new Boiler Quant site', 'Why we rebuilt the website and what\'s coming next.', 'Exec Board', 'Sep 1, 2026', 'Announcements', '06'],
];
const tabs = ['All', 'Education', 'Projects', 'Club life', 'Announcements'];
---

<section data-tone={header} class="border-b border-(--border)">
	<div class="mx-auto max-w-6xl px-6 pt-20 pb-10">
		<p class="font-mono text-xs tracking-wider text-(--accent) uppercase">Blog</p>
		<h1 class="mt-3 text-4xl font-semibold tracking-tight text-(--heading) sm:text-5xl">Notes from the club</h1>
		<p class="mt-4 max-w-xl text-lg text-(--muted)">Writing from members on quant finance, project work, and life in the club.</p>
		<div class="mt-8 flex flex-wrap gap-2">
			{tabs.map((t, i) => (
				<a href="#" class:list={['rounded-full border px-3.5 py-1.5 text-sm transition-colors', i === 0 ? 'border-(--accent) bg-(--accent) text-(--btn-fg) font-medium' : 'border-(--border) text-(--muted) hover:text-(--fg)']} style={i === 0 ? 'color: var(--bg)' : ''}>{t}</a>
			))}
		</div>
	</div>
</section>

<section data-tone={list}>
	<div class="mx-auto grid max-w-6xl gap-5 px-6 py-12 lg:grid-cols-2">
		{posts.map(([title, summary, author, date, tag, n]) => (
			<a href="#" class="group flex gap-5 rounded-lg border border-(--border) bg-(--card) p-4 transition-colors hover:bg-(--card-hover)">
				<div class="flex aspect-[4/3] w-32 shrink-0 items-center justify-center rounded-md bg-(--bg) sm:w-44" style="background: linear-gradient(135deg, var(--gold-deep), var(--ink))">
					<span class="font-mono text-xs text-(--gold)">fig. {n}</span>
				</div>
				<div class="flex min-w-0 flex-col">
					<p class="font-mono text-[11px] tracking-wider text-(--accent) uppercase">{tag}</p>
					<h2 class="mt-1 text-lg leading-snug font-semibold group-hover:underline">{title}</h2>
					<p class="mt-1.5 line-clamp-2 text-sm text-(--muted)">{summary}</p>
					<p class="font-mono mt-auto pt-3 text-xs text-(--muted)">{author} · {date}</p>
				</div>
			</a>
		))}
	</div>
</section>
