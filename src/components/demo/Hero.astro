---
// Full-screen opening visual with a statement that expands into a paragraph as
// you scroll, while the visual fades out (the D. E. Shaw pattern).
import type { Tone } from './directions';
interface Props { fadeTo: Tone }
const { fadeTo } = Astro.props;
const fadesToLight = fadeTo !== 'dark';
---

<section id="hero" data-tone={fadeTo} class="relative h-[220vh]" data-fade-light={fadesToLight ? 'true' : undefined}>
	<div class="sticky top-0 h-screen overflow-hidden">
		<!-- Dark layer + visual, both fade with scroll progress -->
		<div data-tone="dark" class="absolute inset-0 transition-none" style="opacity: calc(1 - var(--p, 0))">
			<canvas id="viz" class="absolute inset-0 h-full w-full" style="opacity: calc(1 - var(--p, 0) * 1.4)"></canvas>
			<div class="absolute inset-0 bg-gradient-to-t from-(--ink) via-transparent to-transparent"></div>
		</div>

		<div class="relative mx-auto flex h-full max-w-6xl flex-col justify-end px-6 pb-20">
			<p class="font-mono mb-6 text-xs tracking-wider uppercase" style={`color: ${fadesToLight ? 'color-mix(in srgb, var(--gold) calc((1 - var(--p, 0)) * 100%), var(--gold-deep))' : 'var(--gold)'}`}>
				Purdue University · est. 2019
			</p>
			<p
				class="max-w-4xl text-[1.75rem] leading-[1.2] font-medium tracking-tight sm:text-4xl lg:text-[2.75rem]"
				style={fadesToLight ? 'color: color-mix(in srgb, var(--white) calc((1 - var(--p, 0)) * 100%), var(--black))' : 'color: var(--white)'}
			>
				<span>We are Boiler Quant, Purdue's student-run quantitative finance club.</span>
				<span style="opacity: var(--p, 0)">
					We bring together students from math, computer science, engineering, and economics to learn how modern markets actually work: by building trading strategies, running research projects, and competing against each other and other schools. Our alumni now trade and build at the firms that define the industry.
				</span>
			</p>
			<p class="font-mono mt-8 text-xs text-(--muted)" style="opacity: calc(1 - var(--p, 0) * 3)">Scroll ↓</p>
		</div>
	</div>
</section>

<script>
	// --- Scroll progress: 0 at top, 1 when the hero has fully scrolled through.
	const hero = document.getElementById('hero')!;
	const update = () => {
		const range = hero.offsetHeight - window.innerHeight;
		const p = Math.min(1, Math.max(0, window.scrollY / range));
		hero.style.setProperty('--p', p.toFixed(3));
	};
	window.addEventListener('scroll', update, { passive: true });
	window.addEventListener('resize', update);
	update();

	// --- Abstract market visual: a few random-walk lines drifting left, in gold.
	const canvas = document.getElementById('viz') as HTMLCanvasElement;
	const ctx = canvas.getContext('2d')!;
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const N = 180;
	const series = Array.from({ length: 6 }, (_, i) => ({
		pts: [] as number[],
		alpha: 0.18 + i * 0.14,
		width: 1 + i * 0.25,
		vol: 0.6 + Math.random() * 0.8,
		y: 0.35 + Math.random() * 0.4,
	}));
	for (const s of series) {
		let v = 0;
		for (let i = 0; i < N; i++) { v += (Math.random() - 0.5) * s.vol; s.pts.push(v); }
	}
	let w = 0, h = 0;
	const resize = () => {
		const dpr = Math.min(2, window.devicePixelRatio || 1);
		w = canvas.clientWidth; h = canvas.clientHeight;
		canvas.width = w * dpr; canvas.height = h * dpr;
		ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
	};
	const draw = () => {
		ctx.clearRect(0, 0, w, h);
		ctx.strokeStyle = 'rgba(255,255,255,0.05)';
		ctx.lineWidth = 1;
		for (let x = 0; x < w; x += 80) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke(); }
		for (let y = 0; y < h; y += 80) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke(); }
		for (const s of series) {
			ctx.beginPath();
			ctx.strokeStyle = `rgba(234,217,158,${s.alpha})`;
			ctx.lineWidth = s.width;
			s.pts.forEach((v, i) => {
				const x = (i / (N - 1)) * w;
				const y = h * s.y - v * (h / 60);
				i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
			});
			ctx.stroke();
		}
	};
	let last = 0;
	const tick = (t: number) => {
		if (t - last > 60) {
			last = t;
			for (const s of series) { s.pts.shift(); s.pts.push(s.pts[s.pts.length - 1] + (Math.random() - 0.5) * s.vol); }
			draw();
		}
		if (!reduce) requestAnimationFrame(tick);
	};
	resize(); draw();
	window.addEventListener('resize', () => { resize(); draw(); });
	if (!reduce) requestAnimationFrame(tick);
</script>
