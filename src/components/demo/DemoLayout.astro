---
import '../../styles/global.css';
import '../../styles/demo.css';
import { directions, type Dir, type Tone } from './directions';

interface Props { dir: Dir; page: 'home' | 'about' | 'blog'; bodyTone: Tone }
const { dir, page, bodyTone } = Astro.props;
const d = directions[dir];
const base = `/demo/${dir}`;
const links = [
	{ href: `${base}/`, label: 'Home', key: 'home' },
	{ href: `${base}/about`, label: 'About', key: 'about' },
	{ href: '#', label: 'Team', key: '' },
	{ href: '#', label: 'News', key: '' },
	{ href: '#', label: 'Placements', key: '' },
	{ href: `${base}/blog`, label: 'Blog', key: 'blog' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>Demo {dir.toUpperCase()} · {d.name} · {page}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body data-demo data-tone={bodyTone} class="flex min-h-screen flex-col antialiased">
		<!-- Direction switcher: demo-only -->
		<div data-tone="dark" class="font-mono flex flex-wrap items-center gap-x-4 gap-y-1 border-b border-(--border) px-4 py-1.5 text-xs text-(--muted)">
			<span>DEMO</span>
			{(['a', 'b', 'c'] as Dir[]).map((k) => (
				<a href={`/demo/${k}/${page === 'home' ? '' : page}`} class:list={['hover:text-(--fg)', k === dir && 'text-(--accent) font-medium']}>
					{k.toUpperCase()} {directions[k].name}
				</a>
			))}
			<span class="ml-auto hidden sm:inline">{d.tagline}</span>
		</div>

		<header data-tone={d.nav} class:list={['sticky top-0 z-20 border-b border-(--border)', d.nav === 'dark' && 'bg-(--card)!']}>
			<nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
				<a href={`${base}/`} class="flex items-center gap-3">
					<img src={d.nav === 'dark' ? '/club_logos/bq_logo_black.png' : '/club_logos/bq_logo_white.png'} alt="" class="h-8 w-8 rounded-sm" />
					<span class="text-base font-semibold tracking-tight">Boiler Quant</span>
				</a>
				<ul class="hidden items-center gap-7 md:flex">
					{links.map((l) => (
						<li>
							<a
								href={l.href}
								class:list={[
									'text-sm transition-colors hover:text-(--accent)',
									l.key === page ? 'text-(--accent) font-medium' : 'text-(--fg)',
								]}
							>
								{l.label}
							</a>
						</li>
					))}
					<li>
						<a href="#" class="rounded-md bg-(--btn-bg) px-3.5 py-2 text-sm font-medium text-(--btn-fg) transition-colors hover:bg-(--btn-hover)">Join us</a>
					</li>
				</ul>
				<button class="rounded border border-(--border) px-3 py-2 text-sm md:hidden" aria-label="Menu">☰</button>
			</nav>
		</header>

		<div class="flex-1">
			<slot />
		</div>

		<footer data-tone={d.footer} class="border-t border-(--border)">
			<div class="mx-auto grid max-w-6xl gap-10 px-6 py-14 md:grid-cols-[1.5fr_1fr_1fr_1fr]">
				<div>
					<p class="text-lg font-semibold">Boiler Quant</p>
					<p class="mt-2 max-w-xs text-sm text-(--muted)">Purdue University's student-run quantitative finance club.</p>
				</div>
				{[
					['Club', ['About', 'Team', 'Placements']],
					['Content', ['News & events', 'Blog']],
					['Contact', ['boilerquant@purdue.edu', 'Instagram', 'LinkedIn']],
				].map(([title, items]) => (
					<div>
						<p class="font-mono text-xs tracking-wider text-(--accent) uppercase">{title}</p>
						<ul class="mt-3 space-y-2 text-sm">
							{(items as string[]).map((i) => <li><a href="#" class="hover:text-(--accent)">{i}</a></li>)}
						</ul>
					</div>
				))}
			</div>
			<div class="mx-auto max-w-6xl border-t border-(--border) px-6 py-5 font-mono text-xs text-(--muted)">© {new Date().getFullYear()} Boiler Quant</div>
		</footer>
	</body>
</html>
