---
// Heading for a section within a page. Eyebrow is optional.
interface Props { eyebrow?: string; title: string; lede?: string; as?: 'h2' | 'h3'; class?: string }
const { eyebrow, title, lede, as: Tag = 'h2', class: className } = Astro.props;
---

<div class:list={['max-w-2xl', className]}>
	{eyebrow && <p class="eyebrow">{eyebrow}</p>}
	<Tag class:list={['text-3xl font-semibold tracking-tight text-heading', eyebrow && 'mt-3']}>{title}</Tag>
	{lede && <p class="mt-3 text-muted">{lede}</p>}
</div>
