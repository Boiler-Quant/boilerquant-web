---
// Tall vertical card for the projects grid (two per row on wide screens):
// banner image on top (gold gradient if the project has none), then title,
// summary, lead line and tags.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Tag from './Tag.astro';
interface Props { href: string; title: string; summary: string; meta?: string; tags?: string[]; image?: ImageMetadata }
const { href, title, summary, meta, tags = [], image } = Astro.props;
---

<a href={href} class="group flex h-full min-h-[22rem] flex-col rounded-lg border border-edge bg-card p-5 transition-colors hover:bg-card-hover">
	<div class="aspect-[16/9] w-full overflow-hidden rounded-md bg-linear-to-br from-gold-deep to-ink">
		{image && <Image src={image} alt="" width={800} height={450} fit="cover" class="h-full w-full object-cover" />}
	</div>
	<div class="flex grow flex-col pt-5">
		<h3 class="text-xl leading-snug font-semibold group-hover:underline">{title}</h3>
		<p class="mt-2 line-clamp-3 text-muted">{summary}</p>
		{meta && <p class="meta mt-auto pt-4">{meta}</p>}
		{tags.length > 0 && (
			<ul class:list={['flex flex-wrap gap-2', meta ? 'mt-3' : 'mt-auto pt-4']}>
				{tags.map((t) => <li><Tag>{t}</Tag></li>)}
			</ul>
		)}
	</div>
</a>
