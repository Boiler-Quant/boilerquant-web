---
// Tall vertical card for the projects grid (two per row on wide screens):
// banner on top, then tag, title, summary and meta line.
interface Props { href: string; title: string; summary: string; meta: string; tag?: string; label?: string }
const { href, title, summary, meta, tag, label } = Astro.props;
---

<a href={href} class="group flex h-full min-h-[22rem] flex-col rounded-lg border border-edge bg-card p-5 transition-colors hover:bg-card-hover">
	<div class="flex aspect-[16/9] w-full items-center justify-center rounded-md bg-linear-to-br from-gold-deep to-ink">
		<span class="font-mono text-xs text-gold">{label ?? '—'}</span>
	</div>
	<div class="flex grow flex-col pt-5">
		{tag && <p class="eyebrow text-[11px]">{tag}</p>}
		<h3 class:list={['text-xl leading-snug font-semibold group-hover:underline', tag && 'mt-1']}>{title}</h3>
		<p class="mt-2 line-clamp-3 text-muted">{summary}</p>
		<p class="meta mt-auto pt-4">{meta}</p>
	</div>
</a>
