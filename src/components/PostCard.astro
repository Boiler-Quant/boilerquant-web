---
// Wide horizontal card used for news items and posts:
// thumbnail on the left, text on the right. One per row.
interface Props { href: string; title: string; summary: string; meta: string; tag?: string; label?: string }
const { href, title, summary, meta, tag, label } = Astro.props;
---

<a href={href} class="group flex gap-5 rounded-lg border border-edge bg-card p-4 transition-colors hover:bg-card-hover sm:gap-6 sm:p-5">
	<div class="flex aspect-[4/3] w-28 shrink-0 items-center justify-center rounded-md bg-linear-to-br from-gold-deep to-ink sm:w-44">
		<span class="font-mono text-xs text-gold">{label ?? '—'}</span>
	</div>
	<div class="flex min-w-0 flex-col">
		{tag && <p class="eyebrow text-[11px]">{tag}</p>}
		<h2 class:list={['text-lg leading-snug font-semibold group-hover:underline sm:text-xl', tag && 'mt-1']}>{title}</h2>
		<p class="mt-1.5 line-clamp-2 text-sm text-muted sm:text-base">{summary}</p>
		<p class="meta mt-auto pt-3">{meta}</p>
	</div>
</a>
