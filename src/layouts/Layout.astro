---
// Shared page shell: <head>, nav bar, footer. Styles come from global.css only.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
	noindex?: boolean; // hide from search engines (e.g. /styleguide)
	fullBleed?: boolean; // page manages its own sections (home)
}
const {
	title,
	description = "Boiler Quant — Purdue University's student-run quantitative finance club.",
	noindex = false,
	fullBleed = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title} · Boiler Quant</title>
	</head>
	<body class="flex min-h-screen flex-col">
		<Header />
		<main class:list={['flex-1', !fullBleed && 'pb-8']}>
			<slot />
		</main>
		<Footer />
	</body>
</html>
