---
// Shared page shell: <head>, nav bar, footer. Styles come from global.css only.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	description?: string;
	noindex?: boolean; // hide from search engines (e.g. /styleguide)
	fullBleed?: boolean; // page manages its own sections (home)
	image?: string; // link-preview picture (path or URL); defaults to the club mark
}
const {
	title,
	description = "Boiler Quant — Purdue University's student-run quantitative finance club.",
	noindex = false,
	fullBleed = false,
	image = '/og-image.png',
} = Astro.props;

// Link previews (the card shown when a link is pasted into iMessage, Slack, LinkedIn…)
// need full https:// addresses, built here from the `site` set in astro.config.mjs.
const pageTitle = `${title} · Boiler Quant`;
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" transition:animate="none">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<title>{pageTitle}</title>
		<link rel="canonical" href={pageUrl} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		{/* Open Graph tags: what link previews read. */}
		<meta property="og:site_name" content="Boiler Quant" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={imageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		{/* Client-side routing: links fetch the next page and swap it in place instead of a
		   full reload. transition:animate="none" on <html> and fallback="swap" disable the
		   default crossfade so swaps are instant. */}
		<ClientRouter fallback="swap" />
	</head>
	<body class="flex min-h-screen flex-col">
		<Header />
		<main class:list={['flex-1', !fullBleed && 'pb-8']}>
			<slot />
		</main>
		<Footer />
	</body>
</html>
